# Copy to .env.local for local development, or add these in your host's settings (Vercel → Project → Settings → Environment Variables).

# AI speaking coach (console.anthropic.com → Settings → API keys). Server-only: never prefix with NEXT_PUBLIC_.
ANTHROPIC_API_KEY=
# Optional: the model the coach uses. Default claude-opus-5-5; claude-haiku-5-5 is much cheaper.
COACH_MODEL=

# Accounts and progress sync (supabase.com → Project Settings → API). Run supabase/schema.sql once first.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Built-in "Ask Claude" chat: set to 1 once the supabase/functions/ask function is deployed with an Anthropic key.
NEXT_PUBLIC_ASK_CHAT=
